.condition {
  position: relative;
  height: 200rpx;
  margin-left: 10rpx;
  padding-top: 4rpx;
  box-sizing: border-box;
}

.filter-line {
  display: flex;
  align-items: center;
  height: 66rpx;
}

.filter-label {
  flex: none;
  width: 82rpx;
  color: #090541;
  font-size: 30rpx;
}

.filter-scroll {
  flex: 1;
  width: 1px;
  height: 100%;
  white-space: nowrap;
}

.filter-options {
  display: inline-flex;
  align-items: center;
  min-width: 100%;
  height: 100%;
  white-space: nowrap;
}

.weaponIcon {
  margin-left: 5rpx;
  width: 40rpx;
  height: 40rpx;
}

.skillIcon {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  top: 10rpx;
}

.searchIcon {
  flex: none;
  width: 65rpx;
  height: 65rpx;
  margin: 0 7rpx 0 0;
}

.clear-filter {
  flex: none;
  width: 126rpx;
  margin: 0 4rpx 0 10rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(210, 221, 122, .5);
  border-radius: 24rpx;
  color: #e4e8c5;
  background: linear-gradient(135deg, rgba(91, 105, 61, .92), rgba(48, 58, 43, .96));
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, .22), inset 0 1rpx 0 rgba(255, 255, 255, .12);
  font-size: 18rpx;
  line-height: normal;
  letter-spacing: 1rpx;
}

.clear-filter:active {
  background: linear-gradient(135deg, rgba(117, 132, 75, .95), rgba(59, 72, 49, .98));
  transform: scale(.97);
}

.skinList {
  width: auto;
  height: 80rpx;
  z-index: 1;
  position: absolute;
  top: 5rpx;
  left: 10rpx;
  right: 10rpx;
  white-space: nowrap;
}

.skinRow {
  display: inline-flex;
  align-items: center;
  height: 100%;
  white-space: nowrap;
}

.iconImg {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  margin-right: 8rpx;
  border: 2rpx solid rgba(239, 212, 72, .8);
  border-radius: 50%;
  background: rgba(20, 25, 20, .8);
}

.card {
  border: 5rpx solid#efd448;
  border-radius: 10rpx;
  width: 98%;
  margin-top: 5rpx;
  background-color: rgba(110, 115, 107, 0.7);
  border-style: double;
}

.title {
  color: #010054;
  font-size: 30rpx !important;
  font-weight: bolder;
}

.name {
  color: #fffcad;
  font-size: 30rpx !important;
  font-weight: bolder;
}

.card>view {
  display: inline-block;
}

.infoIcon {
  width: 50rpx;
  height: 50rpx;
}

.faceImg {
  width: 180rpx;
  height: 180rpx;
  background-color: #dcdcec;
}

.faceIcon {
  position: relative;
}

.faceIcon:after {
  content: "";
  position: absolute;
  top: -13rpx;
  left: -10rpx;
  width: 110%;
  height: 110%;
  background: url(https://fire-emblem-heroes.com/common/img/sp/index/characterSlide/character_thumb_frame_active.png)no-repeat;
  background-size: 100%;
}

.faceIcon>.infoIcon {
  position: absolute;
  z-index: 2;
}

.card-line>label {
  padding-left: 10rpx;
  font-size: small;
  color: azure;
}

.weapon-name {
  color: rgb(0 0 0) !important;
  font-size: 30rpx !important;
  font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
  font-weight: bolder;
}

.detailAttr {
  height: 30rpx;
}
