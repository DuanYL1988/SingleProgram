<!-- 条件 -->
<view class="condition">
  <view class="filter-line">
    <text class="filter-label">移动</text>
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-options">
        <image wx:for="{{moveType}}" wx:key="index" class="searchIcon" src="{{item.imgSrc}}" mut-bind:tap="doSearch" data-key="moveType" data-value="{{item.param}}" />
      </view>
    </scroll-view>
    <button class="clear-filter" size="mini" bindtap="doSearch" data-key="clean">清除筛选</button>
  </view>

  <view class="filter-line">
    <text class="filter-label">出自</text>
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-options">
        <image wx:for="{{enteyList}}" wx:key="index" class="searchIcon" src="{{item.imgSrc}}" mut-bind:tap="doSearch" data-key="entry" data-value="{{item.param}}" />
      </view>
    </scroll-view>
  </view>

  <view class="filter-line">
    <text class="filter-label">武器</text>
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-options">
        <image wx:for="{{weaponType}}" wx:key="index" class="searchIcon" src="{{item.imgSrc}}" mut-bind:tap="doSearch" data-key="weaponType" data-value="{{item.param}}" />
      </view>
    </scroll-view>
  </view>
</view>

<!-- 一览 -->
<scroll-view class="row" style="max-height: 720px;border: 3rpx solid skyblue;" scroll-y>
  <block wx:for="{{fireEmblemHeros}}" wx:key="index">
    <view class="card">
      <view class="faceIcon" mut-bind:tap="getJoinData" data-hero="{{item}}" >
        <image class="faceImg" src="{{item.faceImg}}" />
        <image class="infoIcon" style="left: 5rpx;top:135rpx; width: 50rpx;height: 50rpx;" src="{{moveIcon[item.moveType].imgSrc}}" />
        <image class="infoIcon" style="left: -5rpx;width: 60rpx;height: 60rpx;" src="{{weaponIcon[item.weaponType].imgSrc}}" />
      </view>
      <view class="infoArea">
        <view class="card-line">
          <label class="title">{{item.titleName}}</label>
          <label class="name">{{item.name}}</label>
        </view>
        <view class="card-line">
          <label class="weapon-name">{{item.skillList[0]}}</label>
        </view>
        <view class="card-line detailAttr">
          <label>HP:{{item.hp}} 攻击:{{item.atk}} 速度:{{item.spd}} 防御:{{item.def}} 魔防:{{item.res}} </label>
        </view>
        <view class="card-line detailAttr">
          <label wx:if="{{''!==item.skillList[1]}}"><image class="skillIcon" src="{{item.skillList[2]}}" />{{item.skillList[1]}}</label>
          <label wx:if="{{''!==item.skillList[3]}}"><image class="skillIcon" src="{{item.skillList[4]}}" />{{item.skillList[3]}}</label>
        </view>
        <view class="card-line detailAttr" style="margin-top:10rpx">
          <label wx:if="{{''!==item.skillList[5]}}"><image class="skillIcon" src="{{item.skillList[6]}}" />{{item.skillList[5]}} </label>
          <label><image class="skillIcon" src="{{imgHost + '2/25/Icon_Skill_Special.png'}}" />{{item.skillList[8]}}</label>
        </view>
      </view>
    </view>

  </block>
</scroll-view>

<view style="position: relative;">
  <scroll-view class="skinList" scroll-x>
    <view class="skinRow">
      <image wx:for="{{joinList}}" wx:key="index" class="iconImg" src="{{item.faceImg}}" mut-bind:tap="showFeHero" data-hero="{{item}}" />
    </view>
  </scroll-view>

  <!-- 轮播图 -->
  <swiper id="bannerIllm" class="albumBox" style="padding-top: 85rpx;" current="0" indicator-dots circular>
    <swiper-item class="albumBoxItem" wx:for="{{bannerImages}}" wx:key="index">
      <image referrer-policy="origin" class="albumBoxImg" mode="aspectFill" src="{{item}}" />
    </swiper-item>
  </swiper>
</view>
