page { min-height: 100%; background: #101411; color: #e9e8df; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.page-shell { min-height: 100vh; padding: 0 28rpx 44rpx; box-sizing: border-box; background: radial-gradient(ellipse at 78% 10%, rgba(93, 130, 121, .16), transparent 42%), #101411; }
.topline { height: 78rpx; display: flex; align-items: center; color: #a8ab9c; font-size: 17rpx; letter-spacing: 3rpx; border-bottom: 1rpx solid rgba(226, 228, 207, .12); }
.topline-mark { width: 11rpx; height: 11rpx; margin-right: 12rpx; background: #86c6b7; transform: rotate(45deg); }
.topline-count { margin-left: auto; color: #73796c; letter-spacing: 1rpx; }
.feature-card { position: relative; margin-top: 22rpx; padding: 32rpx 30rpx 22rpx; overflow: hidden; border: 1rpx solid rgba(211, 218, 185, .19); background: linear-gradient(145deg, rgba(43, 58, 53, .97), rgba(25, 31, 27, .98) 55%, rgba(21, 25, 22, .97)); box-shadow: 0 20rpx 54rpx rgba(0, 0, 0, .24); }
.feature-card:before { content: ""; position: absolute; top: 0; left: 0; width: 5rpx; height: 100%; background: #84c9b7; }
.feature-copy { position: relative; z-index: 2; padding: 0 0 16rpx 4rpx; }
.eyebrow, .section-kicker { display: block; color: #9ebdb0; font-size: 17rpx; letter-spacing: 3rpx; }
.feature-name { display: block; margin-top: 14rpx; color: #f2f0e5; font-size: 48rpx; font-weight: 600; letter-spacing: 3rpx; }
.feature-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 14rpx; }
.feature-badge, .faction-badge { display: flex; align-items: center; gap: 7rpx; padding: 6rpx 11rpx; border: 1rpx solid rgba(202, 211, 185, .22); color: #c7cbbb; font-size: 18rpx; }
.feature-badge image { width: 27rpx; height: 27rpx; }
.faction-badge { color: #9ebdb0; }
.art-stage { position: relative; height: 860rpx; margin: 8rpx -5rpx 0; overflow: hidden; background: radial-gradient(ellipse at 50% 42%, rgba(99, 143, 128, .22), transparent 58%), linear-gradient(180deg, rgba(13, 17, 15, .06), rgba(10, 13, 12, .48)); }
.stage-art { position: relative; z-index: 1; width: 100%; height: 100%; animation: art-arrive .42s ease-out; }
.art-vignette { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, rgba(18, 23, 19, .3), transparent 20%, transparent 80%, rgba(18, 23, 19, .25)), linear-gradient(0deg, rgba(14, 18, 16, .48), transparent 22%); }
.art-caption { position: absolute; z-index: 2; right: 8rpx; bottom: 12rpx; left: 8rpx; display: flex; justify-content: space-between; color: #cbd0bd; font-size: 15rpx; letter-spacing: 2rpx; }
.art-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #77867b; font-size: 22rpx; letter-spacing: 2rpx; }
.art-gallery { padding-top: 15rpx; }
.gallery-heading { display: block; margin-bottom: 10rpx; color: #9ba28d; font-size: 18rpx; letter-spacing: 2rpx; }
.gallery-heading text { margin-left: 8rpx; color: #718278; font-size: 16rpx; }
.gallery-scroll, .filter-scroll { width: 100%; white-space: nowrap; }
.gallery-row, .filter-row { display: inline-flex; gap: 10rpx; padding-bottom: 5rpx; }
.gallery-thumb { position: relative; display: inline-block; width: 110rpx; height: 75rpx; overflow: hidden; border: 1rpx solid rgba(210, 216, 194, .17); opacity: .68; }
.gallery-thumb image { width: 100%; height: 100%; }
.gallery-thumb view { position: absolute; right: 0; bottom: 0; left: 0; overflow: hidden; padding: 3rpx 4rpx; color: #fff; background: rgba(10, 14, 12, .68); text-overflow: ellipsis; white-space: nowrap; font-size: 13rpx; }
.gallery-thumb.gallery-active { border-color: #89d0bd; opacity: 1; }
.roster-heading { display: flex; align-items: end; justify-content: space-between; margin: 38rpx 2rpx 18rpx; }
.section-kicker { color: #7e9689; font-size: 15rpx; }
.section-title { display: block; margin-top: 5rpx; color: #ecebdf; font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.result-count { padding-bottom: 4rpx; color: #899080; font-size: 19rpx; }
.search-box { display: flex; align-items: center; height: 76rpx; padding: 0 19rpx; border: 1rpx solid rgba(206, 214, 187, .19); background: rgba(255, 255, 255, .035); }
.search-icon { margin-right: 13rpx; color: #88cbb9; font-size: 35rpx; }
.search-box input { flex: 1; height: 100%; color: #e6e7dc; font-size: 22rpx; }
.search-placeholder { color: #6e766c; }
.clear-search { color: #8fd0be; font-size: 18rpx; }
.filter-label { display: block; margin-top: 18rpx; margin-bottom: 9rpx; color: #859386; font-size: 17rpx; letter-spacing: 1rpx; }
.weapon-label { margin-top: 13rpx; }
.filter-row { gap: 12rpx; }
.filter-chip { display: inline-block; padding: 10rpx 18rpx; border: 1rpx solid rgba(202, 211, 185, .16); color: #9ea497; font-size: 19rpx; }
.filter-chip.filter-active { border-color: #83c5b3; color: #e2e6d4; background: rgba(100, 170, 149, .13); }
.operator-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15rpx; margin-top: 20rpx; }
.operator-card { min-width: 0; overflow: hidden; border: 1rpx solid rgba(207, 214, 192, .13); background: rgba(255, 255, 255, .035); }
.operator-selected { border-color: rgba(127, 203, 179, .8); box-shadow: 0 0 0 1rpx rgba(127, 203, 179, .12); }
.card-image-wrap { position: relative; height: 210rpx; overflow: hidden; background: linear-gradient(145deg, #323a36, #1a201b); }
.operator-face { width: 100%; height: 100%; transition: transform .25s ease; }
.operator-card:active .operator-face { transform: scale(1.06); }
.card-rarity { position: absolute; left: 8rpx; bottom: 8rpx; color: #9bd4c2; text-shadow: 0 1rpx 4rpx #000; font-size: 17rpx; letter-spacing: 1rpx; }
.card-attribute { position: absolute; top: 7rpx; right: 7rpx; width: 36rpx; height: 36rpx; padding: 4rpx; box-sizing: border-box; background: rgba(12, 16, 13, .68); }
.card-attribute image { width: 100%; height: 100%; }
.operator-info { padding: 10rpx 9rpx 12rpx; }
.operator-name { display: block; overflow: hidden; color: #e4e5da; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.operator-class { display: block; overflow: hidden; margin-top: 5rpx; color: #879181; font-size: 15rpx; text-overflow: ellipsis; white-space: nowrap; }
.empty-state { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 70rpx 0; color: #8c9384; font-size: 22rpx; }
.empty-symbol { color: #88cbb9; font-size: 60rpx; }
.load-more { height: 74rpx; margin: 24rpx 0 0; border: 1rpx solid rgba(130, 198, 178, .4); border-radius: 0; color: #a6ddcc; background: rgba(130, 198, 178, .07); font-size: 20rpx; line-height: 74rpx; }
.footer-note { padding: 32rpx 0 8rpx; color: #5e665c; text-align: center; font-size: 14rpx; letter-spacing: 2rpx; }
@keyframes art-arrive { from { opacity: .45; transform: translateY(8rpx); } to { opacity: 1; transform: translateY(0); } }
